# Normalize text files, keep Windows scripts CRLF.
* text=auto

*.py text
*.md text
*.txt text
*.html text
*.css text
*.js text
*.json text
*.yml text
*.yaml text

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.7z binary
*.exe binary
*.db binary
*.sqlite binary
